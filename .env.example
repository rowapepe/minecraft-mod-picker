# Единый файл настроек для всего проекта. Скопируйте в .env и заполните.
# .env в Git не попадает. Здесь только имена переменных, без значений (RULE-AUTH-02).
# Значения для локального запуска: docs/Tech/02-running.md

# Учётные записи (RULE-AUTH-02)
USER_LOGIN=
USER_PASSWORD=
ADMIN_LOGIN=
ADMIN_PASSWORD=

# Ключ подписи cookie сессии (бэкенд)
SESSION_SECRET=

# LLM: GigaChat (D-18). LLM_API_KEY — ключ авторизации из личного кабинета GigaChat API
LLM_API_KEY=
# Модель, по умолчанию GigaChat
LLM_MODEL=
# Для физлиц GIGACHAT_API_PERS (по умолчанию)
LLM_SCOPE=
# Сертификаты Минцифры (.pem); по умолчанию certs/russian_trusted_ca.pem из репозитория
LLM_CA_BUNDLE=
# Адрес GigaChat API; по умолчанию https://gigachat.devices.sberbank.ru/api/v1
LLM_BASE_URL=

# Выгрузка корпуса с Modrinth
MODRINTH_USER_AGENT=

# Адрес настоящего бэкенда для прокси интерфейса, например http://localhost:8000.
# Если не задан, `npm run dev` поднимает заглушку API (D-26).
# API_TARGET=
