# Единый файл настроек для всего проекта. Скопируйте в .env и заполните.
# .env в Git не попадает. Здесь только имена переменных, без значений (RULE-AUTH-02).
# Значения для локального запуска: docs/Tech/02-running.md

# Учётные записи (RULE-AUTH-02)
USER_LOGIN=
USER_PASSWORD=
ADMIN_LOGIN=
ADMIN_PASSWORD=

# Ключ подписи cookie сессии (бэкенд)
SESSION_SECRET=

# LLM
LLM_API_KEY=
LLM_MODEL=

# Выгрузка корпуса с Modrinth
MODRINTH_USER_AGENT=

# Адрес настоящего бэкенда для прокси интерфейса, например http://localhost:8000.
# Если не задан, `npm run dev` поднимает заглушку API (GAP-13).
# API_TARGET=
